    "lucide-react": "^1.24.0",
    "luxon": "^3.7.2",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.9.2",
    "rehype-katex": "^7.0.1",
