# tests/ stays IN the context: next build typechecks src/**/__tests__, whose
# jest-dom matcher types come from tests/setup.ts. The runner stage copies
# only .next/standalone, .next/static, public and boot.js — tests never ship.
*.md
dist/
*.tsbuildinfo

# Agent worktrees (.claude/worktrees/*, each with its own node_modules)
# are not part of the image — keep them out of the build context.
.claude
